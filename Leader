    lb.addServer(std::make_shared<BackendServer>("Server_A", "65.2.127.208", 8080));
    lb.addServer(std::make_shared<BackendServer>("Server_B", "15.207.110.155", 8080));
    lb.addServer(std::make_shared<BackendServer>("Server_C", "15.252.108.112", 8080));
    lb.addServer(std::make_shared<BackendServer>("Server_D", "3.6.126.183", 8080));

    std::cout << "\n--- Starting Automated Background Traffic Generator ---\n";
    AutomatedTrafficSimulator simulator(lb);
    simulator.start(15); // Generate ~15 automated requests/sec

    // 2. Monitor real-time dynamic load variations over 6 seconds
    for (int second = 1; second <= 6; ++second) {
        std::this_thread::sleep_for(std::chrono::seconds(1));

        std::cout << "\n==================================================";
        std::cout << "\n[REAL-TIME METRICS - SECOND " << second << "]";
        std::cout << "\n==================================================\n";

        for (const auto& server : lb.getServers()) {
            std::cout << server->id << " -> Active Connections: " 
                      << server->active_connections.load() << "\n";
        }
    }

    std::cout << "\nStopping traffic simulator...\n";
    simulator.stop();

    return 0;
}